# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to git or share it publicly.

# Meta WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=curex-verify-2026

# Your real deployed domain, no trailing slash (used to build links sent in WhatsApp replies)
SITE_BASE_URL=https://yourdomain.com

# Optional: powers AI replies for open-ended patient questions the menu doesn't cover.
# Get a key at https://console.anthropic.com/ — leave blank to disable (bot uses a canned
# fallback reply instead; nothing breaks if this is empty).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated emails that get notified on new appointments / "talk to a human" requests.
# Leave blank to disable notifications (they're just skipped, not an error).
STAFF_NOTIFICATION_EMAILS=

# Optional social links — leave blank to hide the icon on the site.
SITE_FACEBOOK=
SITE_INSTAGRAM=
SITE_TWITTER=

# Django secret key — generate a fresh one for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# --- Production deployment only (leave unset for local development) ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=curex.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://curex.onrender.com

# --- Database (leave unset for local dev — uses SQLite automatically) ---
# Render provides this automatically when you attach a Postgres database via render.yaml.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Media storage (IMPORTANT for Render/Railway/Heroku — see README section 11) ---
# Render's disk is wiped on every deploy/restart. Without S3-compatible storage, uploaded
# test results and product images WILL be lost. Set USE_S3=True and fill these in before
# relying on result uploads in production. Works with AWS S3, Cloudflare R2, Backblaze B2,
# or DigitalOcean Spaces (anything S3-API compatible).
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
